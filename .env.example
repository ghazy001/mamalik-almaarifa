# Optional for game-server. Defaults require no secrets or cloud services.
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=2567
NODE_ENV=development
# Next.js uses port 3000 through its dev/start scripts.
# For apps/web, set this in apps/web/.env.local or export it before pnpm dev.
# This is the browser-reachable HTTP(S) URL of the persistent Colyseus service.
GAME_SERVER_URL=http://127.0.0.1:2567

# Optional M4 local content CLI; pnpm dev still needs no database.
# Start with: docker compose up -d --wait
# Local-only credentials from compose.yaml; never use these on a hosted service.
DATABASE_URL=postgresql://mamalik_content:local-content-only@127.0.0.1:5433/mamalik_content
# Test runner creates/drops only its own randomly named database and role.
# Bootstrap privileges are for this local test tool only, never web/game clients.
DATABASE_TEST_ADMIN_URL=postgresql://postgres:local-bootstrap-only@127.0.0.1:5433/postgres
# Private rooms and basic guest matchmaking require no database or account.

# Optional M4 server/CLI content API; disabled until all settings are configured.
CONTENT_ADMIN_ENABLED=false
# Optional reviewed online room bank; requires DATABASE_URL, not Auth credentials.
# New rooms need at least 36 published unique questions; no fixture fallback.
GAME_QUESTION_SOURCE=development
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_actual_publishable_key
# No service-role key or JWT signing secret is needed by the game server.
# Never expose DATABASE_URL or bootstrap credentials in NEXT_PUBLIC_* variables.

# Optional M4 web portal for EXISTING content-team accounts, disabled by default.
# Export these before pnpm dev, or use apps/web/.env.local for web settings.
# A root .env is not automatically loaded by Next.js/Turbo.
WEB_AUTH_ENABLED=false
WEB_AUTH_ORIGIN=http://127.0.0.1:3000
CONTENT_ADMIN_URL=http://127.0.0.1:2567
# Use the same SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY as the game server.
# HTTPS is required except for loopback development. No NEXT_PUBLIC_* auth values.
# WEB_AUTH_ORIGIN must exactly match the browser origin, including the port.
