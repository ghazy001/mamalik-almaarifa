{
  "name": "@mamalik/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run --exclude tests/content-admin.postgres.test.ts --exclude tests/published-bank.postgres.test.ts --exclude tests/match-results.postgres.test.ts",
    "test:admin": "node --import tsx ../../packages/database/scripts/test-database.ts server",
    "test:room-bank": "node --import tsx ../../packages/database/scripts/test-database.ts rooms",
    "test:results": "node --import tsx ../../packages/database/scripts/test-database.ts results"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/ws-transport": "0.18.4",
    "@mamalik/database": "workspace:*",
    "@mamalik/game-core": "workspace:*",
    "@mamalik/question-fixtures": "workspace:*",
    "@mamalik/shared": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "^17.2.0",
    "express": "5.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.8",
    "@mamalik/config": "workspace:*",
    "@types/express": "^5.0.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.14"
  }
}
