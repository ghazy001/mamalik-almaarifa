{
  "name": "mamalik-al-marifa",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "pnpm --filter @mamalik/game-core simulate",
    "test:e2e": "pnpm --filter @mamalik/web test:e2e",
    "test:database": "pnpm --filter @mamalik/database test:integration",
    "test:admin": "pnpm --filter @mamalik/database... build && pnpm --filter @mamalik/game-server test:admin",
    "test:room-bank": "pnpm --filter @mamalik/game-server... build && pnpm --filter @mamalik/game-server test:room-bank",
    "test:results": "pnpm --filter @mamalik/game-server... build && pnpm --filter @mamalik/game-server test:results",
    "test:content-web": "pnpm --filter @mamalik/database... build && node --import tsx packages/database/scripts/test-database.ts web",
    "db:migrate": "pnpm --filter @mamalik/database db:migrate",
    "content": "pnpm --filter @mamalik/question-fixtures... build && pnpm --filter @mamalik/database content"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
