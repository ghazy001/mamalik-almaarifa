{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["GAME_SERVER_URL"],
  "globalPassThroughEnv": ["PORT", "GAME_SERVER_HOST", "GAME_SERVER_PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@mamalik/web#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "WEB_AUTH_ENABLED",
        "WEB_AUTH_ORIGIN",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "CONTENT_ADMIN_URL"
      ]
    },
    "@mamalik/game-server#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CONTENT_ADMIN_ENABLED",
        "SUPABASE_URL",
        "SUPABASE_PUBLISHABLE_KEY",
        "DATABASE_URL"
      ]
    }
  }
}
